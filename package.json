{
  "name": "movie-show-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run dev",
    "build": "npm --workspace frontend run build",
    "start": "npm --workspace backend run start",
    "seed": "npm --workspace backend run seed",
    "check": "npm --workspace frontend run check && npm --workspace backend run check",
    "test": "npm --workspace backend run test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}

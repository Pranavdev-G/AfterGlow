# Copy this file to .env and replace values as appropriate.
# The local app expects MongoDB on 127.0.0.1:27017.
MONGODB_URI=mongodb://127.0.0.1:27017/afterglow_cinema
# Required outside local demo mode; use a long random value and never commit .env.
JWT_SECRET=replace-with-a-long-random-secret-before-production
# API port for the local Express service. Manus Preview's frontend listens on PORT (3000).
API_PORT=5000
# Fictional sample theatre schedules use Asia/Kolkata wall-clock time by default.
APP_TIMEZONE=Asia/Kolkata
# Local / preview demonstration fallback only. Set false in production.
DEMO_MODE=true
# Set these only when intentionally creating privileged demonstration accounts.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
